POSTGRES_DB=dreamdesk
POSTGRES_USER=dreamdesk
POSTGRES_PASSWORD=replace_with_random_hex_password
MAIN_DB_SCHEMA=t_p67567221_one_file_page_projec

# Смена JWT_SECRET завершит все ранее выданные сеансы.
JWT_SECRET=replace_with_random_hex_jwt_secret

# Должен быть Fernet-ключом. Для расшифровки существующих настроек интеграций
# укажите тот же ключ, который использовался до переноса.
INTEGRATION_ENCRYPTION_KEY=replace_with_fernet_key

# Локальный снимок не добавляется в Git.
DB_SEED_PATH=./docker/postgres/seed.dump

# Необязательные внешние интеграции. Ядро запускается без них.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=
BITRIX24_PORTAL_URL=
BITRIX24_WEBHOOK_URL=
GIGACHAT_AUTH_KEY=
ROUTERAI_API_KEY=
VAPID_PRIVATE_KEY=
USE_EMBEDDINGS=false
