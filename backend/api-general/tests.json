{
  "tests": [
    {
      "name": "Get Users Unauthorized",
      "method": "GET",
      "path": "/?resource=users",
      "expectedStatus": 401
    },
    {
      "name": "Get Categories Unauthorized",
      "method": "GET",
      "path": "/?resource=categories",
      "expectedStatus": 401
    },
    {
      "name": "Get Roles Unauthorized",
      "method": "GET",
      "path": "/?resource=roles",
      "expectedStatus": 401
    },
    {
      "name": "CORS Preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get System Settings Unauthorized",
      "method": "GET",
      "path": "/?resource=system_settings",
      "expectedStatus": 401
    },
    {
      "name": "DB Backup Status Unauthorized",
      "method": "GET",
      "path": "/?resource=db_backup&action=status&job_id=1",
      "expectedStatus": 401
    },
    {
      "name": "DB Backup Create Unauthorized",
      "method": "POST",
      "path": "/?resource=db_backup",
      "body": {"action": "create", "mode": "full"},
      "expectedStatus": 401
    },
    {
      "name": "DB Backup Internal Run Without Secret Forbidden",
      "method": "POST",
      "path": "/?resource=db_backup",
      "body": {"action": "run", "job_id": 1, "mode": "full"},
      "expectedStatus": 403
    },
    {
      "name": "CSV Export Tables Unauthorized",
      "method": "GET",
      "path": "/?resource=csv_export&action=tables",
      "expectedStatus": 401
    },
    {
      "name": "CSV Export Status Unauthorized",
      "method": "GET",
      "path": "/?resource=csv_export&action=status&job_id=1",
      "expectedStatus": 401
    },
    {
      "name": "CSV Export Create Unauthorized",
      "method": "POST",
      "path": "/?resource=csv_export",
      "body": {"action": "create", "scope": "all"},
      "expectedStatus": 401
    },
    {
      "name": "CSV Export Internal Run Without Secret Forbidden",
      "method": "POST",
      "path": "/?resource=csv_export",
      "body": {"action": "run", "job_id": 1},
      "expectedStatus": 403
    }
  ]
}