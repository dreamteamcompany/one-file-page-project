{
  "tests": [
    {
      "name": "OPTIONS CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Создание учётки РФ — успех",
      "method": "POST",
      "path": "/",
      "body": {
        "portal": "ru",
        "last_name": "Лалиев",
        "first_name": "Роберт",
        "middle_name": "Захарович",
        "position": "Менеджер",
        "department": "Продажи",
        "city": "Москва",
        "gender": "male",
        "phone": "+79000000000",
        "targets": ["bitrix", "email"]
      },
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true,
        "demo": true,
        "portal": "ru"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Без портала — ошибка",
      "method": "POST",
      "path": "/",
      "body": {
        "last_name": "Лалиев",
        "first_name": "Роберт"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Без имени — ошибка",
      "method": "POST",
      "path": "/",
      "body": {
        "portal": "kz",
        "last_name": "Лалиев"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Настройки без токена — 401",
      "method": "GET",
      "path": "/?action=settings",
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Сохранение настроек без токена — 401",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "save_settings",
        "values": {}
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    }
  ]
}